<launch>
  <arg name="limb" default="left" doc="Which limb to control: left or right" />
  <arg name="solver_mode" default="qc" doc="MPC formulation: qc or time_scaling" />
  <arg name="solver_backend" default="osqp" doc="Solver: osqp, ipopt, or qpoases" />
  <arg name="mpc_rate_hz" default="50.0" doc="MPC command update rate" />
  <arg name="cycle_deadline_ms" default="20.0" doc="Maximum state-to-command latency" />

  <rosparam command="load"
            file="$(find baxter_mpc_controller)/config/config.yaml" />
  <param name="robot/solver_mode" value="$(arg solver_mode)" />
  <param name="robot/solver_backend" value="$(arg solver_backend)" />
  <param name="robot/control/mpc_rate_hz" value="$(arg mpc_rate_hz)" />
  <param name="robot/control/cycle_deadline_ms" value="$(arg cycle_deadline_ms)" />

  <node name="mpc_controller_node_$(arg limb)"
        pkg="baxter_mpc_controller"
        type="run_mpc"
        output="screen"
        args="$(arg limb)" />
</launch>
