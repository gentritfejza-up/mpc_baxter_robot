<launch>
  <arg name="limb" default="left" doc="Which limb to control: left or right" />
  <arg name="gui" default="true" doc="Open the Gazebo client" />
  <arg name="headless" default="false" doc="Run Gazebo without rendering" />
  <arg name="solver_backend" default="osqp" doc="Solver: osqp, qpoases, qrqp, ipqp, or ipopt" />
  <arg name="mpc_rate_hz" default="50.0" doc="MPC command update rate" />
  <arg name="cycle_deadline_ms" default="20.0" doc="Maximum state-to-command latency" />
  <arg name="reference_interval_sec" default="10.0" doc="Seconds between test poses" />
  <arg name="report_interval_sec" default="1.0" doc="Seconds between tracking reports" />
  <arg name="repeat_references" default="false" doc="Repeat the five-pose sequence" />
  <arg name="auto_enable" default="true" doc="Enable the simulated robot after startup" />

  <include file="$(find baxter_gazebo)/launch/baxter_world.launch">
    <arg name="gui" value="$(arg gui)" />
    <arg name="headless" value="$(arg headless)" />
  </include>

  <include file="$(find baxter_dynamics)/launch/lagrange_euler.launch">
    <arg name="limb" value="$(arg limb)" />
  </include>

  <include file="$(find baxter_mpc_controller)/launch/mpc_controller.launch">
    <arg name="limb" value="$(arg limb)" />
    <arg name="solver_mode" value="qc" />
    <arg name="solver_backend" value="$(arg solver_backend)" />
    <arg name="mpc_rate_hz" value="$(arg mpc_rate_hz)" />
    <arg name="cycle_deadline_ms" value="$(arg cycle_deadline_ms)" />
  </include>

  <group if="$(arg auto_enable)">
    <node name="mpc_sim_reference_sender"
          pkg="baxter_mpc_controller"
          type="send_sim_references.py"
          output="screen"
          args="--limb $(arg limb) --interval $(arg reference_interval_sec) --report-interval $(arg report_interval_sec) --enable-simulator $(eval '--repeat' if arg('repeat_references') == 'true' else '')" />
  </group>
  <group unless="$(arg auto_enable)">
    <node name="mpc_sim_reference_sender"
          pkg="baxter_mpc_controller"
          type="send_sim_references.py"
          output="screen"
          args="--limb $(arg limb) --interval $(arg reference_interval_sec) --report-interval $(arg report_interval_sec) $(eval '--repeat' if arg('repeat_references') == 'true' else '')" />
  </group>
</launch>
