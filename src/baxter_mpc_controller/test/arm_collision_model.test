<launch>
  <param name="robot_description"
         command="$(find xacro)/xacro $(find baxter_description)/urdf/baxter.urdf.xacro gazebo:=true left_electric_gripper:=true right_electric_gripper:=true" />
  <rosparam command="load" file="$(find baxter_mpc_controller)/config/collision_geometry.yaml" />
  <param name="robot/geometry/base_link" value="base" />

  <test test-name="arm_collision_model_test" pkg="baxter_mpc_controller"
        type="arm_collision_model_test" time-limit="120.0" />
</launch>
